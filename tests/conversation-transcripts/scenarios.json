      "Claremont Capetown"
    ],
    "assertions": [
      "location_input_is_accepted",
      "progress_is_preserved",
      "terms_are_explicit",
      "registration_does_not_restart",
      "verification_is_next_step"
    ]
  },
  {
    "name": "john_provider_location_resume",
    "role": "handyman",
    "messages": [
      "ROLE_USE_HANDYMAN",
      "John",
      "LAILA CONSTRUCTION",
      "Ceilings & Drywall",
      "Bellville Cape Town",
      "continue"
    ],
    "assertions": [
      "location_input_is_accepted",
      "resume_uses_saved_progress",
      "no_duplicate_provider_record"
    ]
  },
  {
    "name": "fridge_customer_resume",
    "role": "customer",
    "messages": [
      "REQUEST_HELP",
      "my fridge is broken",
      "CONFIRM_SERVICE",
      "Langa Cape Town",
      "JI_URGENT",
      "JI_SKIP_PHOTO",
      "JI_SUBMIT",
      "continue"
