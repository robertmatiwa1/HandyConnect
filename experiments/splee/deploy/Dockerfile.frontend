# Experimental Splee frontend; pinned source required.
FROM node:22-bookworm AS build
ARG SPLEE_REF
RUN test -n "$SPLEE_REF"
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /src
RUN git clone https://github.com/Iweisc/splee.git . && git checkout --detach "$SPLEE_REF"
WORKDIR /src/frontend
RUN pnpm install --frozen-lockfile
ARG API_URL
RUN test -n "$API_URL" && API_URL="$API_URL" pnpm build

FROM node:22-bookworm-slim
RUN corepack enable
WORKDIR /app
COPY --from=build /src/frontend ./
ENV NODE_ENV=production
ENV PORT=3333
EXPOSE 3333
CMD ["pnpm", "start"]
