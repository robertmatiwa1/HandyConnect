      "resume_returns_to_unfinished_request",
      "no_duplicate_job"
    ]
  },
  {
    "name": "unsupported_request_blocked",
    "role": "customer",
    "messages": ["REQUEST_HELP", "my wife is pregnant"],
    "assertions": ["request_is_not_matchable", "no_job_created"]
  },
  {
    "name": "mixed_trade_request_is_ambiguous",
    "role": "customer",
    "messages": ["REQUEST_HELP", "my toilet leaks and my socket is broken"],
    "assertions": ["request_requires_clarification", "no_job_created"]
  },
  {
    "name": "stale_accept_button",
    "role": "handyman",
    "messages": ["ACCEPT:expired-match-id"],
    "assertions": ["no_assignment_created", "safe_current_state_response"]
  },
  {
    "name": "duplicate_accept",
    "role": "handyman",
    "messages": ["ACCEPT:valid-match-id", "ACCEPT:valid-match-id"],
    "assertions": ["single_assignment", "second_action_is_replay_safe"]
  },
  {
    "name": "duplicate_arrival_start_complete",
    "role": "marketplace",
    "messages": [
      "ARRIVED:job-id",
      "ARRIVED:job-id",
      "CONFIRM_START:job-id",
      "CONFIRM_START:job-id",
      "COMPLETE:job-id",
      "COMPLETE:job-id",
      "CONFIRM_COMPLETE:job-id",
      "CONFIRM_COMPLETE:job-id"
    ],
    "assertions": [
      "single_arrival_event",
      "single_start_event",
      "single_completion_request_event",
      "single_completion_event"
    ]
  },
  {
    "name": "unverified_provider_resume",
    "role": "handyman",
    "messages": ["hi"],
    "precondition": "registered_unverified_provider",
    "assertions": ["verification_is_primary_resume_action"]
  },
  {
    "name": "active_job_provider_resume",
    "role": "handyman",
    "messages": ["hello"],
    "precondition": "verified_provider_with_active_job",
    "assertions": ["current_job_is_primary_resume_action"]
  }
