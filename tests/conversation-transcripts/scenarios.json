  {
    "name": "reuben_provider_location_and_terms_recovery",
    "role": "handyman",
    "messages": [
      "Hello! Can I get more info on this? I am an electrian",
      "ROLE_USE_HANDYMAN",
      "Reuben Matiwa",
      "Tina Electrical Solutions",
